{
  "appId": "com.touringgroup.rooms",
  "appName": "Rooms",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#16131C",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#16131C",
